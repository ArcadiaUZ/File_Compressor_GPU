<Window x:Class="GcfGui.ArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GCF Arxiv" Height="720" Width="1000" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E" Foreground="#E8E8F0">
    <Window.Resources>
        <!-- Toolbar tugmasi: belgi ustida, matn pastda (WinRAR uslubi) -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A3E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#555566"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Yuqori toolbar -->
        <Border DockPanel.Dock="Top" Background="#252536" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Click="AddButton_Click" ToolTip="Arxivga fayl qo'shish">
                    <StackPanel><TextBlock Text="➕" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Qo'shish" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="ExtractButton_Click" ToolTip="Tanlanganlarni papkaga chiqarish">
                    <StackPanel><TextBlock Text="📤" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Chiqarish" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="TestButton_Click" ToolTip="Arxiv butunligini tekshirish">
                    <StackPanel><TextBlock Text="✅" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Tekshirish" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="ViewButton_Click" ToolTip="Tanlangan faylni ochish">
                    <StackPanel><TextBlock Text="👁" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Ko'rish" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="DeleteButton_Click" ToolTip="Tanlanganlarni arxivdan o'chirish">
                    <StackPanel><TextBlock Text="🗑" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="O'chirish" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="InfoButton_Click" ToolTip="Arxiv haqida ma'lumot">
                    <StackPanel><TextBlock Text="ℹ" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Ma'lumot" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Manzil/infobar -->
        <Border DockPanel.Dock="Top" Background="#2A2A3E" Padding="10,6">
            <StackPanel>
                <TextBlock x:Name="ArchPath" FontSize="12" Foreground="#AAAAB8"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArchSummary" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Pastki holat paneli -->
        <Border DockPanel.Dock="Bottom" Background="#252536" Padding="10,6">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#AAAAB8" TextWrapping="Wrap"
                       Text="Tayyor."/>
        </Border>

        <!-- Fayllar ro'yxati -->
        <ListView x:Name="FileList" Background="#1E1E2E" Foreground="#E8E8F0"
                  BorderThickness="0" SelectionMode="Extended">
            <ListView.Resources>
                <!-- Tanlash rangi: ko'zni olmas binafsha-kulrang, matn oq qoladi -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3D3D66"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#33334D"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E8E8F0"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#33334D"/>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="#252536"/>
                    <Setter Property="Foreground" Value="#AAAAB8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="#E8E8F0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="4,3"/>
                    <Style.Triggers>
                        <!-- Hover: juda shaffof, matn bemalol o'qiladi -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2A2A40"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3D3D66"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nomi" Width="280">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Hajm" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Siqilgan" Width="110" DisplayMemberBinding="{Binding PackedText}"/>
                    <GridViewColumn Header="Turi" Width="150" DisplayMemberBinding="{Binding TypeName}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
